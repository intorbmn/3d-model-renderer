{
	"schemaVersion": 1,
	"id": "mmdskin",
	"version": "${version}",
	"name": "3D Model Renderer",
	"description": "Renders MMD (PMX/PMD), VRM and glTF/GLB models in place of players and mobs, with VMD animation and physics. Fork of MMD Skin (MC-MMD-rust) by shiroha233, ported to Minecraft 26.3 Fabric.",
	"authors": [
		"intorbmn"
	],
	"contributors": [
		"shiroha233 (MMD Skin / MC-MMD-rust, upstream)",
		"kjkjkAIStudio (KAIMyEntity, original author)",
		"asuka-mio",
		"Gengorou-C (KAIMyEntity-C)"
	],
	"contact": {
		"homepage": "https://github.com/intorbmn/3d-model-renderer",
		"sources": "https://github.com/intorbmn/3d-model-renderer",
		"issues": "https://github.com/intorbmn/3d-model-renderer/issues"
	},
	"license": "MIT",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.shiroha.mmdskin.fabric.MmdSkinFabric"
		],
		"client": [
			"com.shiroha.mmdskin.fabric.MmdSkinFabricClient"
		]
	},
	"mixins": [
		"mmdskin-fabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "26.3",
		"java": ">=25",
		"fabric-api": "*",
		"cloth-config": "*"
	}
}
